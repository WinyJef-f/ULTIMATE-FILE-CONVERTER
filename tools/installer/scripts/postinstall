#!/bin/bash
# Runs as root after the PKG installs.
set -euo pipefail

# Identify the actual logged-in user (the script runs as root).
CONSOLE_USER=$(stat -f "%Su" /dev/console 2>/dev/null || true)
if [[ -z "$CONSOLE_USER" || "$CONSOLE_USER" == "root" ]]; then
    exit 0
fi

# Enable "Convert with UFC" using the domain-name form of defaults write
# (not the full-path form, which bypasses cfprefsd and fails on macOS 15).
sudo -u "$CONSOLE_USER" /usr/bin/defaults write com.apple.ServicesMenu.Services \
    "Convert with UFC" -bool true 2>/dev/null || true

# Register the app with Launch Services so the NSServices entry is indexed.
/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister \
    /Applications/ULTIMATE-FILE-CONVERTER.app

# Restart Finder as the actual user so the service appears immediately.
sudo -u "$CONSOLE_USER" /usr/bin/killall Finder 2>/dev/null || true

exit 0
