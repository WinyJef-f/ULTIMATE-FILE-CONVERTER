#!/bin/bash
# postinstall script for ULTIMATE-FILE-CONVERTER
# Runs as root after the .app is placed in /Applications/.
# Installs Homebrew (if missing) and every bundled-tool dependency.

set -u

LOG=/tmp/ufc-install.log
exec >>"$LOG" 2>&1

echo "================================================================"
echo "ULTIMATE-FILE-CONVERTER postinstall: $(date)"
echo "Running as $(whoami) (uid=$(id -u))"
echo "================================================================"

# Identify the actual user who launched the installer.
TARGET_USER=$(/usr/bin/stat -f "%Su" /dev/console 2>/dev/null || true)
if [[ -z "$TARGET_USER" || "$TARGET_USER" == "root" ]]; then
    TARGET_USER=$(/usr/bin/who | /usr/bin/awk '/console/ {print $1; exit}')
fi
if [[ -z "$TARGET_USER" || "$TARGET_USER" == "root" ]]; then
    echo "ERROR: Could not identify a non-root user; skipping tool install."
    exit 0
fi
echo "Target user: $TARGET_USER"

# Detect arch + brew prefix.
if [[ "$(/usr/bin/uname -m)" == "arm64" ]]; then
    BREW_PREFIX=/opt/homebrew
else
    BREW_PREFIX=/usr/local
fi
BREW="$BREW_PREFIX/bin/brew"
echo "Expected brew path: $BREW"

# Run a command as the target user with their normal login shell environment.
run_user() {
    /usr/bin/sudo -H -u "$TARGET_USER" /bin/bash -lc "$*"
}

# Install Homebrew non-interactively if missing.
if [[ ! -x "$BREW" ]]; then
    echo "----------------------------------------------------------------"
    echo "Homebrew not found; installing..."
    if run_user 'NONINTERACTIVE=1 /bin/bash -c "$(/usr/bin/curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"'; then
        echo "Homebrew install completed."
    else
        echo "ERROR: Homebrew install failed."
        /usr/bin/osascript -e 'display dialog "ULTIMATE-FILE-CONVERTER is installed, but the automatic Homebrew setup did not finish.\n\nTo finish setup, install Homebrew from https://brew.sh, then in Terminal run:\n\nbrew install ffmpeg imagemagick pandoc ghostscript p7zip librsvg\nbrew install --cask libreoffice\n\nFull log: /tmp/ufc-install.log" buttons {"OK"} default button "OK" with icon caution with title "ULTIMATE-FILE-CONVERTER setup"' &
        exit 0
    fi
fi

if [[ ! -x "$BREW" ]]; then
    echo "ERROR: Homebrew still not at expected path after install attempt; bailing."
    exit 0
fi

# Install formulae.
echo "----------------------------------------------------------------"
echo "brew install ffmpeg imagemagick pandoc ghostscript p7zip librsvg"
if ! run_user "$BREW install ffmpeg imagemagick pandoc ghostscript p7zip librsvg"; then
    echo "WARN: One or more formulae failed; continuing."
fi

# Install LibreOffice if missing.
if [[ ! -d /Applications/LibreOffice.app ]]; then
    echo "----------------------------------------------------------------"
    echo "brew install --cask libreoffice  (large download — slow first time)"
    if ! run_user "$BREW install --cask libreoffice"; then
        echo "WARN: LibreOffice cask install failed; Office formats will not work until it's installed manually."
    fi
else
    echo "LibreOffice already installed at /Applications/LibreOffice.app — skipping."
fi

echo "================================================================"
echo "postinstall finished: $(date)"
echo "================================================================"
exit 0
