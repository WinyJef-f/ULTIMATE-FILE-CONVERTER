<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="UltimateFileConverter.WinUI.Views.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:UltimateFileConverter.WinUI.Models"
    xmlns:conv="using:UltimateFileConverter.WinUI.Converters"
    mc:Ignorable="d">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:QueueStatusToBrushConverter x:Key="StatusBrush" />
    </UserControl.Resources>

    <Grid x:Name="RootGrid" AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop"
          Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="O" Invoked="AddFilesAccelerator_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="R" Invoked="ConvertAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======================= Header / toolbar ======================= -->
        <Grid Grid.Row="0" Padding="20,14,20,12" ColumnSpacing="12"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/logo.png" Width="34" Height="34" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ULTIMATE-FILE-CONVERTER" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Drop any file. Pick any format. Converted locally."
                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Click="AddFiles_Click" ToolTipService.ToolTip="Add files to the queue">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE710;" FontSize="15" />
                        <TextBlock Text="Add files" />
                    </StackPanel>
                </Button>
                <Button Click="ClearQueue_Click" IsEnabled="{x:Bind ViewModel.CanClearQueue, Mode=OneWay}"
                        ToolTipService.ToolTip="Remove all files from the queue">
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE74D;" FontSize="15" />
                </Button>
                <Button Click="Stats_Click" ToolTipService.ToolTip="Conversion stats">
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE9D9;" FontSize="15" />
                </Button>
                <Button Click="Tools_Click" ToolTipService.ToolTip="Set up conversion tools (winget)">
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE90F;" FontSize="15" />
                </Button>
                <Button Click="Settings_Click" ToolTipService.ToolTip="Conversion settings">
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE713;" FontSize="15" />
                </Button>
                <Button Click="Cancel_Click" Visibility="{x:Bind ViewModel.CanCancel, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                        ToolTipService.ToolTip="Cancel the running conversion">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE71A;" FontSize="14" />
                        <TextBlock Text="Cancel" />
                    </StackPanel>
                </Button>
                <Button Click="Convert_Click" Style="{ThemeResource AccentButtonStyle}"
                        IsEnabled="{x:Bind ViewModel.CanConvert, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.CanCancel, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                        Content="{x:Bind ViewModel.ConvertButtonText, Mode=OneWay}"
                        ToolTipService.ToolTip="Convert all pending files" />
            </StackPanel>
        </Grid>

        <!-- ======================= Empty state ======================= -->
        <Grid Grid.Row="1" Padding="20"
              Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <Grid x:Name="EmptyDropZone"
                  Background="Transparent" Tapped="DropZone_Tapped">
                <Rectangle RadiusX="14" RadiusY="14" StrokeThickness="2" StrokeDashArray="6,4"
                           Stroke="{ThemeResource CardStrokeColorDefaultBrush}"
                           Fill="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                <StackPanel Spacing="14" Padding="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE896;" FontSize="52"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="Drop files here" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Or click to browse — multiple files supported" HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ======================= Content state ======================= -->
        <ScrollViewer Grid.Row="1" Padding="20"
                      Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
            <StackPanel Spacing="18">

                <!-- compact drop zone -->
                <Grid x:Name="CompactDropZone" Background="Transparent" Tapped="DropZone_Tapped" Height="56">
                    <Rectangle RadiusX="12" RadiusY="12" StrokeThickness="2" StrokeDashArray="6,4"
                               Stroke="{ThemeResource CardStrokeColorDefaultBrush}"
                               Fill="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="16,0">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE710;" FontSize="16"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Drop more files here, or click to add"
                                   VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <!-- queue section -->
                <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.HasQueue, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Queue" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.QueueCountText, Mode=OneWay}" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Convert to" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <DropDownButton x:Name="TargetPickerButton"
                                            Content="{x:Bind ViewModel.TargetFormatDisplay, Mode=OneWay}"
                                            IsEnabled="{x:Bind ViewModel.HasTargetOptions, Mode=OneWay}" />
                        </StackPanel>
                        <Button Grid.Column="5" Click="ClearFinished_Click" Content="Clear finished"
                                Visibility="{x:Bind ViewModel.HasFinishedItems, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    </Grid>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Queue}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:QueueItem">
                                <Border Margin="0,0,0,6" Padding="12,10" CornerRadius="10"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                VerticalAlignment="Center">
                                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                      Glyph="{x:Bind CategoryGlyph}" FontSize="16"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind MetadataLine, Mode=OneWay}" FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind ErrorMessage, Mode=OneWay}" FontSize="12"
                                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                       IsTextSelectionEnabled="True" TextWrapping="Wrap"
                                                       Visibility="{x:Bind HasError, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <ProgressRing Width="16" Height="16" IsActive="{x:Bind IsConverting, Mode=OneWay}"
                                                          Visibility="{x:Bind IsConverting, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                      Glyph="{x:Bind StatusGlyph, Mode=OneWay}" FontSize="14"
                                                      Foreground="{x:Bind Status, Mode=OneWay, Converter={StaticResource StatusBrush}}"
                                                      Visibility="{x:Bind ShowStatusGlyph, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" FontSize="12" VerticalAlignment="Center"
                                                       Foreground="{x:Bind Status, Mode=OneWay, Converter={StaticResource StatusBrush}}" />
                                        </StackPanel>

                                        <Button Grid.Column="3" Tag="{x:Bind}" Click="QueueItemMore_Click"
                                                Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                                ToolTipService.ToolTip="More actions">
                                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE712;" FontSize="15" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- history section -->
                <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.HasHistory, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Recent" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.HistoryCountText, Mode=OneWay}" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Grid.Column="3" Click="ClearHistory_Click" Content="Clear history" />
                    </Grid>

                    <Border CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.History}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:HistoryEntry">
                                    <Grid ColumnSpacing="12" Padding="12,9"
                                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                  Glyph="{x:Bind CategoryGlyph}" FontSize="14" VerticalAlignment="Center"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind SourceName}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind MetadataLine}" FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Tag="{x:Bind}" Click="HistoryReveal_Click"
                                                Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                                ToolTipService.ToolTip="Show in File Explorer"
                                                Visibility="{x:Bind ShowRevealButton, Converter={StaticResource BoolToVis}}">
                                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE7B3;" FontSize="14" />
                                        </Button>
                                        <FontIcon Grid.Column="2" FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE73E;"
                                                  FontSize="14" VerticalAlignment="Center"
                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                  Visibility="{x:Bind ShowMissingGlyph, Converter={StaticResource BoolToVis}}" />
                                        <FontIcon Grid.Column="2" FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE7BA;"
                                                  FontSize="14" VerticalAlignment="Center"
                                                  Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                  ToolTipService.ToolTip="{x:Bind FailureTooltip}"
                                                  Visibility="{x:Bind ShowFailureGlyph, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
