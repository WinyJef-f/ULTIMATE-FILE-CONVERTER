<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="UltimateFileConverter.WinUI.Views.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Settings"
    PrimaryButtonText="Done"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="540">
        <StackPanel Spacing="22" Width="440" Padding="0,4,4,4">

            <!-- Image -->
            <StackPanel Spacing="6">
                <TextBlock Text="Image" FontWeight="SemiBold" />
                <Grid ColumnSpacing="12" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Quality" VerticalAlignment="Center" />
                    <Slider x:Name="QualitySlider" Grid.Column="1" Minimum="1" Maximum="100"
                            StepFrequency="1" ValueChanged="QualitySlider_ValueChanged" />
                    <TextBlock x:Name="QualityValue" Grid.Column="2" MinWidth="32"
                               TextAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
                <TextBlock Text="Higher quality = larger files. 85 is a good default."
                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Audio -->
            <StackPanel Spacing="6">
                <TextBlock Text="Audio" FontWeight="SemiBold" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Bitrate" VerticalAlignment="Center" />
                    <ComboBox x:Name="BitrateCombo" Grid.Column="1" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="96 kbps" Tag="96" />
                        <ComboBoxItem Content="128 kbps" Tag="128" />
                        <ComboBoxItem Content="192 kbps" Tag="192" />
                        <ComboBoxItem Content="256 kbps" Tag="256" />
                        <ComboBoxItem Content="320 kbps" Tag="320" />
                    </ComboBox>
                </Grid>
            </StackPanel>

            <!-- Video -->
            <StackPanel Spacing="6">
                <TextBlock Text="Video" FontWeight="SemiBold" />
                <Grid ColumnSpacing="12" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Quality (CRF)" VerticalAlignment="Center" />
                    <Slider x:Name="CrfSlider" Grid.Column="1" Minimum="18" Maximum="30"
                            StepFrequency="1" ValueChanged="CrfSlider_ValueChanged" />
                    <TextBlock x:Name="CrfValue" Grid.Column="2" MinWidth="32"
                               TextAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
                <TextBlock Text="Lower CRF = better quality, larger file. 23 is a balanced default."
                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Output folder -->
            <StackPanel Spacing="6">
                <TextBlock Text="Output folder" FontWeight="SemiBold" />
                <ComboBox x:Name="OutputModeCombo" HorizontalAlignment="Stretch" SelectionChanged="OutputModeCombo_SelectionChanged">
                    <ComboBoxItem Content="Next to source file" Tag="NextToSource" />
                    <ComboBoxItem Content="Custom folder…" Tag="CustomFolder" />
                </ComboBox>
                <Grid x:Name="CustomFolderPanel" ColumnSpacing="10" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="FolderPathText" Grid.Column="0" Text="No folder chosen"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button x:Name="ChooseFolderButton" Grid.Column="1" Content="Choose…" Click="ChooseFolder_Click" />
                </Grid>
            </StackPanel>

            <!-- Experimental -->
            <StackPanel Spacing="6">
                <TextBlock Text="Experimental" FontWeight="SemiBold" />
                <ToggleSwitch x:Name="ExperimentalToggle" Header="Convert into unsupported formats"
                              Toggled="ExperimentalToggle_Toggled" />
                <InfoBar x:Name="ExperimentalWarning" IsOpen="False" IsClosable="False" Severity="Warning"
                         Title="Heads up"
                         Message="By enabling this, you can turn ANY file into ANY OTHER file. this may cause unexpected results, or it wont even work at all. Don't say i didn't warn you." />
            </StackPanel>

            <!-- Full History -->
            <StackPanel Spacing="6">
                <TextBlock Text="Full History" FontWeight="SemiBold" />
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="FullHistoryCountLabel" Grid.Column="0" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button x:Name="ClearFullHistoryButton" Grid.Column="1" Content="Clear…"
                            Click="ClearFullHistory_Click" />
                </Grid>
                <TextBlock Text="Stats use full history. Clearing it resets all conversion stats permanently."
                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</ContentDialog>
