<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="UltimateFileConverter.WinUI.Views.StatsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:UltimateFileConverter.WinUI.Models"
    mc:Ignorable="d"
    Title="Stats"
    CloseButtonText="Done"
    DefaultButton="Close">

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
        <StackPanel Spacing="20" Width="460" Padding="0,4,4,4">

            <!-- Overview cards -->
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" CornerRadius="8" Padding="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE73E;"
                                      FontSize="12" Foreground="#22C55E" />
                            <TextBlock Text="Converted" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="SuccessText" FontSize="22" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" CornerRadius="8" Padding="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE711;"
                                      FontSize="12" Foreground="#EF4444" />
                            <TextBlock Text="Failed" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="FailedText" FontSize="22" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" CornerRadius="8" Padding="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE8A5;"
                                      FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Total size" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="BytesText" FontSize="22" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Top formats -->
            <StackPanel x:Name="TopFormatsPanel" Spacing="8">
                <TextBlock Text="Top formats" FontWeight="SemiBold" />
                <Border CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <ItemsControl x:Name="TopFormatsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:StatBarItem">
                                <Grid ColumnSpacing="10" Padding="12,9"
                                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                      BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="32" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Label}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <ProgressBar Grid.Column="1" Value="{x:Bind DoubleCount}"
                                                 Maximum="{x:Bind MaxValue}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind CountText}" FontSize="12"
                                               VerticalAlignment="Center" TextAlignment="Right"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>

            <!-- Top conversions -->
            <StackPanel x:Name="TopPairsPanel" Spacing="8">
                <TextBlock Text="Top conversions" FontWeight="SemiBold" />
                <Border CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <ItemsControl x:Name="TopPairsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:StatBarItem">
                                <Grid ColumnSpacing="10" Padding="12,9"
                                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                      BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="32" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Label}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <ProgressBar Grid.Column="1" Value="{x:Bind DoubleCount}"
                                                 Maximum="{x:Bind MaxValue}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind CountText}" FontSize="12"
                                               VerticalAlignment="Center" TextAlignment="Right"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>

            <!-- Empty state -->
            <StackPanel x:Name="EmptyStatePanel" Spacing="8" HorizontalAlignment="Center" Padding="0,40,0,20">
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE9D9;"
                          FontSize="40" HorizontalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="No conversions yet" FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Stats will appear here after you convert your first file."
                           HorizontalAlignment="Center" TextAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</ContentDialog>
