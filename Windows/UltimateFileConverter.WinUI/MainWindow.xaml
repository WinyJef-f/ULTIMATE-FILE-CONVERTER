<Window
    x:Class="UltimateFileConverter.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="ULTIMATE-FILE-CONVERTER">

    <Grid Padding="24" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16" AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop">
        <StackPanel Orientation="Horizontal" Spacing="14">
            <Border Width="48" Height="48" CornerRadius="12" Background="{ThemeResource AccentFillColorDefaultBrush}">
                <TextBlock Text="UFC" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel>
                <TextBlock Text="ULTIMATE-FILE-CONVERTER" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="Native Windows WinUI 3 port — drag, choose, convert locally." Opacity="0.72" />
            </StackPanel>
        </StackPanel>

        <InfoBar Grid.Row="1"
                 IsOpen="{x:Bind ViewModel.DependencyBannerVisible, Mode=OneWay}"
                 Severity="Informational"
                 Title="First-run Windows tool setup"
                 Message="The app uses winget to install FFmpeg, ImageMagick, Pandoc, LibreOffice, and 7-Zip if they are missing." />

        <Grid Grid.Row="2" ColumnDefinitions="2*,3*" ColumnSpacing="18">
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="16" Padding="18">
                <StackPanel Spacing="14">
                    <TextBlock Text="Drop files here" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="Or use Add files. Converted outputs are written next to the source unless a custom folder is selected." TextWrapping="Wrap" Opacity="0.72" />
                    <Button Content="Add files" Click="AddFiles_Click" />
                    <ComboBox Header="Convert to" ItemsSource="{x:Bind ViewModel.AvailableTargets}" SelectedItem="{x:Bind ViewModel.SelectedTarget, Mode=TwoWay}" DisplayMemberPath="DisplayName" />
                    <ToggleSwitch Header="Experimental raw-byte mode" IsOn="{x:Bind ViewModel.WeirdModeEnabled, Mode=TwoWay}" />
                    <Slider Header="Image quality" Minimum="1" Maximum="100" Value="{x:Bind ViewModel.ImageQualityValue, Mode=TwoWay}" />
                    <Slider Header="Audio bitrate (kbps)" Minimum="64" Maximum="320" StepFrequency="32" Value="{x:Bind ViewModel.AudioBitrateValue, Mode=TwoWay}" />
                    <Slider Header="Video CRF" Minimum="16" Maximum="35" StepFrequency="1" Value="{x:Bind ViewModel.VideoCRFValue, Mode=TwoWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Convert queue" Click="Convert_Click" IsEnabled="{x:Bind ViewModel.CanConvert, Mode=OneWay}" />
                        <Button Content="Cancel" Click="Cancel_Click" IsEnabled="{x:Bind ViewModel.IsConverting, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                <TextBlock Text="Queue" FontSize="22" FontWeight="SemiBold" />
                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Queue}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:QueueItem" xmlns:models="using:UltimateFileConverter.WinUI.Models">
                            <Grid Padding="8" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel>
                                    <TextBlock Text="{x:Bind FileName}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Status}" Opacity="0.70" />
                                    <TextBlock Text="{x:Bind ErrorMessage}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ProgressRing Grid.Column="1" IsActive="{x:Bind IsRunning, Mode=OneWay}" Width="24" Height="24" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.75" />
            </Grid>
        </Grid>

        <TextBlock Grid.Row="3" Text="Supported: images, audio, video, documents, spreadsheets, presentations. Powered by winget-managed CLI tools." Opacity="0.65" />
    </Grid>
</Window>
